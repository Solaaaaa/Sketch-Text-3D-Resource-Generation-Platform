# Copy to a trusted, local .env; deploy/start_app.example.sh sources it as Bash.
# Activate the Linux app environment before launching (also used by ComfyUI).
# Relative paths are resolved
# from the directory containing app.py; any value may be changed to an actual
# absolute path on the target machine. Never commit credentials, model
# weights, datasets, or the real .env file.
SKETCH_PLATFORM_BASE_MODEL=models/FLUX.1-dev
SKETCH_PLATFORM_CONTROLNET_MODEL=models/flux1-dev-visdrone-urban-sketch-controlnet
SKETCH_PLATFORM_FILL_MODEL=models/FLUX.1-Fill-dev
SKETCH_PLATFORM_QWEN_ROOT=external/ComfyUI_Qwen-Multiple-Angles
# QWEN_ROOT contains ComfyUI/main.py; do not append /ComfyUI here.
# App probes /history, reuses a ready service, otherwise starts it on this host/port.
SKETCH_PLATFORM_COMFY_URL=http://127.0.0.1:8188
SKETCH_PLATFORM_COMFY_BIND_HOST=127.0.0.1
SKETCH_PLATFORM_COMFY_PORT=8188
SKETCH_PLATFORM_COMFY_LOG=runtime/qwen_multiangle_comfy.log
SKETCH_PLATFORM_TRELLIS_ROOT=external/TRELLIS
SKETCH_PLATFORM_TRELLIS_RUNNER=trellis_step4_runner.py
TRELLIS_PYTHON_BIN=.venv/bin/python
SKETCH_PLATFORM_TRELLIS_MODEL=models/TRELLIS-image-large
SKETCH_PLATFORM_TRELLIS_WORKDIR=external/TRELLIS
SKETCH_PLATFORM_RUNTIME_ROOT=runtime
# This output-only directory is authorized by Gradio allowed_paths, even outside
# the repository. Do not put private files in it.
SKETCH_PLATFORM_CACHE_ROOT=cache
# App sets TORCH_HOME=<cache>/torch and U2NET_HOME=<cache>/u2net for its runner.
# Prepare DINOv2/U2Net there using deploy/README.md. No main-model cache fallback.
TRELLIS_ATTN_BACKEND=sdpa
